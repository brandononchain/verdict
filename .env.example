# Load into the process environment; never commit real values.
ZEARCH_RESEARCH_ENABLED=0
ZEARCH_SESSION_SECRET=
JEV_MODEL=jev-latest
TYPESAFE_API_KEY=
TAVILY_API_KEY=
DATABASE_URL=
# Enter current contracted USD prices for the selected model and search plan.
ZEARCH_JEV_INPUT_USD_PER_MILLION=
ZEARCH_SEARCH_USD_PER_CALL=
OPENAI_API_KEY=
ZEARCH_WRITER_MODEL=
ZEARCH_WRITER_INPUT_USD_PER_MILLION=
ZEARCH_WRITER_OUTPUT_USD_PER_MILLION=
# Optional rendered-page enrichment (up to 3 sources per run).
ZEARCH_ENRICHMENT_ENABLED=0
CONTEXT_DEV_API_KEY=
ZEARCH_SCRAPE_USD_PER_CALL=
ZEARCH_DAILY_GLOBAL_RUNS=100
ZEARCH_DAILY_SESSION_RUNS=10
ZEARCH_DAILY_GLOBAL_USD=10
ZEARCH_DAILY_SESSION_USD=1

# Enable only after a recurring external worker invocation is installed.
# Run python discovery.py once per minute; each invocation claims at most one job.
ZEARCH_DISCOVERY_ENABLED=0
